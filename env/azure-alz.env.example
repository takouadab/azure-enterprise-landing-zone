# Azure Enterprise Landing Zone — operator-owned environment
# Copy to env/azure-alz.env, replace placeholders, and source in macOS zsh.
# Never commit env/azure-alz.env or real credentials.

# 1. Current main-infra/variables.tf (12 required Terraform root variables)
export TF_VAR_root_id="<YOUR_ALZ_ROOT_ID>"
export TF_VAR_root_name="<YOUR_ALZ_ROOT_DISPLAY_NAME>"
export TF_VAR_primary_location="<PRIMARY_AZURE_REGION>"
export TF_VAR_secondary_location="<SECONDARY_AZURE_REGION>"
export TF_VAR_subscription_id_connectivity="<CONNECTIVITY_SUBSCRIPTION_ID>"
export TF_VAR_subscription_id_identity="<IDENTITY_SUBSCRIPTION_ID>"
export TF_VAR_subscription_id_management="<MANAGEMENT_SUBSCRIPTION_ID>"
export TF_VAR_email_security_contact="<SECURITY_CONTACT_EMAIL>"
export TF_VAR_log_retention_in_days=30
# Keep false until a cost review has been completed.
export TF_VAR_enable_ddos_protection=false
export TF_VAR_connectivity_resources_tags='{"project":"azure-enterprise-landing-zone","layer":"connectivity"}'
export TF_VAR_management_resources_tags='{"project":"azure-enterprise-landing-zone","layer":"management"}'

# 2. Connectivity JSON payloads consumed by scripts/render_infra.py
# Each value has the exact nested outer key expected by the current renderer.
export TF_VAR_xp_hub_network='{"xp_hub_network":{"cidr_block":"<XP_HUB_CIDR>","azure_gateway_subnet":{"name":"GatewaySubnet","ip_range":"<XP_GATEWAY_SUBNET_CIDR>"},"azure_bastion_subnet":{"name":"AzureBastionSubnet","ip_range":"<XP_BASTION_SUBNET_CIDR>"},"azure_firewall_subnet":{"name":"AzureFirewallSubnet","ip_range":"<XP_FIREWALL_SUBNET_CIDR>"},"azure_firewall_management_subnet":{"name":"AzureFirewallManagementSubnet","ip_range":"<XP_FIREWALL_MANAGEMENT_SUBNET_CIDR>"},"shared_services_subnet":{"name":"SharedServicesSubnet","ip_range":"<XP_SHARED_SERVICES_SUBNET_CIDR>"}}}'
# Original XP had Bastion/Firewall enabled; defaults here are safe for planning.
export TF_VAR_xp_hub_bastion='{"xp_hub_bastion":{"enabled":false}}'
export TF_VAR_xp_hub_firewall='{"xp_hub_firewall":{"enabled":false,"firewall_rule_collections":[]}}'

export TF_VAR_appbuild_hub_network='{"appbuild_hub_network":{"cidr_block":"<APPBUILD_HUB_CIDR>","azure_gateway_subnet":{"name":"GatewaySubnet","ip_range":"<APPBUILD_GATEWAY_SUBNET_CIDR>"},"azure_bastion_subnet":{"name":"AzureBastionSubnet","ip_range":"<APPBUILD_BASTION_SUBNET_CIDR>"},"azure_firewall_subnet":{"name":"AzureFirewallSubnet","ip_range":"<APPBUILD_FIREWALL_SUBNET_CIDR>"},"azure_firewall_management_subnet":{"name":"AzureFirewallManagementSubnet","ip_range":"<APPBUILD_FIREWALL_MANAGEMENT_SUBNET_CIDR>"},"shared_services_subnet":{"name":"SharedServicesSubnet","ip_range":"<APPBUILD_SHARED_SERVICES_SUBNET_CIDR>"}}}'
export TF_VAR_appbuild_hub_bastion='{"appbuild_hub_bastion":{"enabled":false}}'
export TF_VAR_appbuild_hub_firewall='{"appbuild_hub_firewall":{"enabled":false,"firewall_rule_collections":[]}}'

export TF_VAR_apprun_hub_network='{"apprun_hub_network":{"cidr_block":"<APPRUN_HUB_CIDR>","azure_gateway_subnet":{"name":"GatewaySubnet","ip_range":"<APPRUN_GATEWAY_SUBNET_CIDR>"},"azure_bastion_subnet":{"name":"AzureBastionSubnet","ip_range":"<APPRUN_BASTION_SUBNET_CIDR>"},"azure_firewall_subnet":{"name":"AzureFirewallSubnet","ip_range":"<APPRUN_FIREWALL_SUBNET_CIDR>"},"azure_firewall_management_subnet":{"name":"AzureFirewallManagementSubnet","ip_range":"<APPRUN_FIREWALL_MANAGEMENT_SUBNET_CIDR>"},"shared_services_subnet":{"name":"SharedServicesSubnet","ip_range":"<APPRUN_SHARED_SERVICES_SUBNET_CIDR>"}}}'
export TF_VAR_apprun_hub_bastion='{"apprun_hub_bastion":{"enabled":false}}'
export TF_VAR_apprun_hub_firewall='{"apprun_hub_firewall":{"enabled":false,"firewall_rule_collections":[]}}'

# 3. Landing Zone inputs for future main-bp (NOT consumed by the current main-infra root)
export TF_VAR_xp_subscriptions='{"xp_subscriptions":[{"id":"<XP_SUBSCRIPTION_ID>","alias_name":"xp001","display_name":"<XP_SUBSCRIPTION_NAME>","status":"active"}]}'
export TF_VAR_xp_spoke_networks='{"xp_spoke_networks":{"xp001":{"cidr_block":"<XP_SPOKE_001_CIDR>"}}}'
export TF_VAR_appbuild_subscriptions='{"appbuild_subscriptions":[{"id":"<APPBUILD_SUBSCRIPTION_ID>","alias_name":"appbuild001","display_name":"<APPBUILD_SUBSCRIPTION_NAME>","status":"active"}]}'
export TF_VAR_appbuild_spoke_networks='{"appbuild_spoke_networks":{"appbuild001":{"cidr_block":"<APPBUILD_SPOKE_001_CIDR>"}}}'
export TF_VAR_apprun_subscriptions='{"apprun_subscriptions":[]}'
export TF_VAR_apprun_spoke_networks='{"apprun_spoke_networks":{"apprun001":{"cidr_block":"<APPRUN_SPOKE_001_CIDR>"}}}'

# 4. Additional reference variables (future main-bp / platform integration)
# This variable is visible in the screenshots, but is NOT declared by the current main-infra code.
# export TF_VAR_log_analytics_workspace_id="<LOG_ANALYTICS_WORKSPACE_ID>"
# export TF_VAR_billing_account_name="<BILLING_ACCOUNT_NAME>"
# export TF_VAR_billing_profile_name="<BILLING_PROFILE_NAME>"
# export TF_VAR_bastion_xp_user_object_ids='["<AZURE_ENTRA_OBJECT_ID>"]'
# export TF_VAR_bastion_appbuild_user_object_ids='["<AZURE_ENTRA_OBJECT_ID>"]'
# export TF_VAR_bastion_apprun_user_object_ids='["<AZURE_ENTRA_OBJECT_ID>"]'

# 5. Authentication: use existing `az login` for local work by default.
# Uncomment only for service-principal authentication; do not commit real secrets.
# export ARM_TENANT_ID="<TENANT_ID>"
# export ARM_SUBSCRIPTION_ID="<SUBSCRIPTION_ID>"
# export ARM_CLIENT_ID="<APP_CLIENT_ID>"
# export ARM_CLIENT_SECRET="<CLIENT_SECRET>"
# The certificate/private-key auth shown in the reference is an alternative, not simultaneous.

# 6. HTTP backend: only if you have YOUR OWN HTTP Terraform state service.
# TF_ADDRESS/TF_USERNAME/TF_PASSWORD are GitLab wrapper conventions, not native HTTP backend names.
# Native Terraform backend environment variables are the following:
# export TF_HTTP_ADDRESS="<STATE_ENDPOINT>"
# export TF_HTTP_USERNAME="<STATE_USERNAME>"
# export TF_HTTP_PASSWORD="<STATE_PASSWORD>"
# export TF_HTTP_LOCK_ADDRESS="<LOCK_ENDPOINT>"
# export TF_HTTP_LOCK_METHOD="POST"
# export TF_HTTP_UNLOCK_ADDRESS="<LOCK_ENDPOINT>"
# export TF_HTTP_UNLOCK_METHOD="DELETE"
