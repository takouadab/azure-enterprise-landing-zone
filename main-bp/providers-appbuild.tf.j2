# Generated from providers-appbuild.tf.j2. Do not edit.
{% for subscription in subscriptions if subscription.status == 'active' %}
provider "azurerm" {
  alias                           = "appbuild_{{ subscription.alias_name }}"
  features {}
  subscription_id                 = {{ subscription.id | tojson }}
  resource_provider_registrations = "none"
}

provider "azapi" {
  alias           = "appbuild_{{ subscription.alias_name }}"
  subscription_id = {{ subscription.id | tojson }}
}
{% endfor %}
